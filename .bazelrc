# transfemme-tailoring Bazel Configuration
#
# Bazel 8 + Bzlmod. Two-registry chain: xoxd-ai/bazel-registry (formerly
# tinyland-inc) first, then BCR. The site build, check, unit tests and dev
# server are Bazel targets (BUILD.bazel); `just` is the entrypoint.
#
# The registry is pinned to an immutable commit (the site.scaffold pattern) so
# module metadata cannot change under us; scripts/check-inhouse-package-parity.py
# proves every in-house module in MODULE.bazel.lock resolves from this pin.
# Bump it in its own commit together with the regenerated lock:
#   sed -i "s|bazel-registry/[0-9a-f]\{40\}|bazel-registry/$(gh api repos/xoxd-ai/bazel-registry/commits/main --jq .sha)|" .bazelrc
#   bazelisk mod deps --lockfile_mode=update

common --enable_bzlmod
common --registry=https://raw.githubusercontent.com/xoxd-ai/bazel-registry/195ab44cc559788ff28bf7eb91d9610812ed0033
common --registry=https://bcr.bazel.build

# BASE_PATH and commit identity are stable Bazel inputs to the stamped //:build
# action (scripts/bazel/run-vite-build.mjs reads them).
build --workspace_status_command=scripts/bazel/workspace-status.sh

# Build performance
build --jobs=auto
build --worker_sandboxing
build --disk_cache=~/.cache/bazel-transfemme-tailoring
build --keep_going
build --show_timestamps

# Flywheel cache + REAPI behavior lives in .bazelrc.flywheel, but endpoint
# authority lives in scripts/gloriousflywheel-bazel.sh. The wrapper passes
# --remote_cache and optional --remote_executor explicitly from validated env.
# See docs/CI-SCHEMA.md §5 for the contract.
try-import %workspace%/.bazelrc.flywheel

# rules_ts: skip lib check is required for SvelteKit-style declaration files.
build --@aspect_rules_ts//ts:skipLibCheck=always
build --spawn_strategy=sandboxed,worker,local

# CI: hosted runners, no remote cache.
build:ci --remote_retries=3
build:ci --jobs=auto
build:ci --color=no
build:ci --curses=no
build:ci --show_progress_rate_limit=30
build:ci --noshow_loading_progress

# Test output
test --test_output=errors
test --test_summary=detailed
test --test_verbose_timeout_warnings
test --test_timeout=120,600,1800,3600

try-import %workspace%/user.bazelrc
